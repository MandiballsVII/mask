  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'MASK is a dual-channel rhythm game where you have to push the correct
    buttons on both sides of the screen to the beat of the music.


    On the left
    side of the screen, you have to hold down the direction corresponding to the
    arrow that appears at that moment.


    On the right side, you have to press
    the colored buttons when they approach the center of the screen.


    Please
    note: The use of (xbox) gamepad is recommended

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bb3083e97c736b2408226ba87dd44148, type: 2}
